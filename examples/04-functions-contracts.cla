// 04-functions-contracts.cla — functions, contracts, expression bodies,
// generics with interface bounds, and the purity bit on function parameters.
//
// Exercises: per-parameter and relational preconditions, postconditions (`it` =
// result), `= expression` bodies, generics `<T>` / bounds `<T: Ord>` / multiple
// bounds, turbofish, and a higher-order function that requires a `pure` callback.
//
// KEY RULE (position disambiguates): a `where` zone BEFORE `->` is a
// precondition (scope: the parameters); a `where` zone AFTER the return type is a
// postcondition (binder `it` = the result).
//
// Forward references: `len` is the intrinsic length measure (05); `Ord`/`Show`
// are core interfaces (09); the `(x) => …` lambda is detailed in 11.

import std::io::{println, IoError};

// ---- expression body + postcondition -------------------------------------
fun abs(x: I32) -> I32 where it >= 0 =
    if x < 0 { <- -x } else { <- x };
// abs(I32 min) traps: `-x` overflows for x == -2^31 (ADR-0006). The postcondition
// still holds — a trap never returns, so "if abs returned, it >= 0".

// ---- inline per-parameter precondition (sugar for one param's `where`) ----
fun sqrt_floor(n: I64 where n >= 0) -> I64 {
    let r = 0;
    while (r + 1) * (r + 1) <= n { r = r + 1; }
    return r;
}

// ---- relational precondition in the pre-`->` zone (references both params) -
// `len` is a measure, so it may appear in a predicate (ADR-0003). The precondition
// discharges the index obligation of `xs[i]` for the caller.
fun get(xs: [I32], i: U64) where i < len(xs) -> I32 {
    return xs[i];
}

// ---- postcondition relating the result to a parameter --------------------
fun double(x: I32) -> I32 where it == x * 2 = x * 2;

// ---- generics: bounds, and the value-level-refinement boundary -----------
// `max` works over any `T: Ord`, but it CANNOT state `where it >= a` — that is a
// value-level refinement over the abstract `T`, deferred to a later extension
// (needs interface-published measures, ADR-0007).
fun max<T: Ord>(a: T, b: T) -> T {
    if a > b { return a; }
    return b;
}

// Multiple bounds, plus a STRUCTURE-level refinement over a generic — `len(xs)`
// is concrete per instantiation, so this one works in v1.
fun first<T: Ord + Show>(xs: [T]) where len(xs) > 0 -> T {
    return xs[0];
}

// ---- higher-order: a pure function requiring a pure callback --------------
// Because `apply_twice` is `pure`, its callback type must be `pure (T) -> T`; a
// non-pure callback can't be passed (it would make the body non-pure). A function
// type carries any contracts via refinement-typed components, e.g.
// `pure ({v: I32 | v > 0}) -> I32` — there is no `where`-sugar inside a fn type,
// and fully-general higher-order contracts are a later extension (see CONTEXT).
pure fun apply_twice<T>(f: pure (T) -> T, x: T) -> T = f(f(x));

fun main() -> Result<Void, IoError> {
    fix a  = abs(-5);             // 5
    fix s  = sqrt_floor(17);      // 4
    fix d  = double(21);          // 42 (and `it == 21 * 2` is proven)
    fix m  = max(3, 9);           // 9  (T inferred as I64)
    fix m2 = max::<I32>(3, 9);    // 9  (turbofish: explicit type argument)

    fix inc = (n: I64) => n + 1;  // a pure lambda
    fix t   = apply_twice(inc, 10);   // inc(inc(10)) == 12

    println(a)?;
    println(d)?;
    println(t)?;
    return Ok(void);
}
